{
  "name": "handoff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx --conditions=react-server scripts/prepare-deploy.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "sync": "tsx --conditions=react-server scripts/sync.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "backfill": "tsx --conditions=react-server scripts/backfill-history.ts",
    "admins": "tsx --conditions=react-server scripts/promote-admins.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "7zip-bin": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
